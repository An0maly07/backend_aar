# Copy to .env and adjust. Every value has a safe development default.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# SQLite now, MySQL later (pip install PyMySQL):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/women_safety?charset=utf8mb4

# Frontend origin(s) allowed to call the API with cookies (comma-separated)
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Public URL of this backend, used in the live-tracking link sent to contacts
PUBLIC_BASE_URL=http://localhost:5000

# Alert channels: console (dev), email (SMTP), sms (Twilio)
ALERT_CHANNELS=console
ALERT_ASYNC=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

DEFAULT_COUNTRY_CODE=+91
EMERGENCY_NUMBER=112

# AI risk policy (Low < medium <= Medium < high <= High)
RISK_MEDIUM_THRESHOLD=0.40
RISK_HIGH_THRESHOLD=0.75
RISK_CONFIRM_WINDOW_SECONDS=60
